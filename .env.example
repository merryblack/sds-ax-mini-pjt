# Copy to .env and fill in. Never commit .env.

# AWS Bedrock credentials (provided by the course)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Models (defaults in src/a11y_investigator/config.py; see docs/decisions.md)
# CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-6
# CHAT_MODEL_ID_LIGHT=us.anthropic.claude-haiku-4-5-20251001-v1:0
# EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Node.js path for the static analyzer (optional; PATH and C:\Program Files\nodejs are searched)
# NODE_BIN=C:\Program Files\nodejs\node.exe
